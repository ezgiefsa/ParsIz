[Unit]
Description=Parsİz RAM to Disk Sync Service
DefaultDependencies=no
Conflicts=reboot.target shutdown.target halt.target
Before=shutdown.target reboot.target halt.target umount.target
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/local/bin/parsiz-shutdown.sh
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
